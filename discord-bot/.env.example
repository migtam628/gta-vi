# Get the token at https://discord.com/developers/applications -> Bot
# Keep this file private; do not paste your token in chat or commit it.
DISCORD_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
# Enable Developer Mode in Discord, then right-click #gta6-countdown -> Copy Channel ID.
DISCORD_CHANNEL_ID=REPLACE_WITH_YOUR_TEXT_CHANNEL_ID
# 11:45 PM Eastern on November 18, 2026 == 04:45 UTC Nov 19.
KICKOFF_UTC=2026-11-19T04:45:00+00:00
# Edit frequency in seconds (minimum 15; higher values reduce API requests).
UPDATE_INTERVAL_SECONDS=15
# Shared public Discord countdown: bi (English + Español), en, or es.
COUNTDOWN_LANGUAGE=bi
PIN_MESSAGE=false
# Automatic bilingual GTA VI community campaign, Nov 10–30, 2026.
# The second Docker service automatically publishes approved schedule entries.
AUTO_POST_ENABLED=true
AUTO_POST_CHECK_SECONDS=60
# If the VPS was temporarily offline, don't publish stale reminders.
AUTO_POST_GRACE_MINUTES=120
